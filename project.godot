config_version=5

[application]
config/name="BEAVER MAYHEM"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="REVENGE OF THE FOREST"

[display]
window/size/viewport_width=432
window/size/viewport_height=864
window/size/window_width_override=432
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.19,0.31,0.33,1)

[audio]
default_bus_layout="res://default_bus_layout.tres"
